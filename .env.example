# Copier ce fichier en .env.local pour le développement (jamais commité).
# Supabase (facultatif — sans ces valeurs l'app tourne en « mode local »)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# SHA-256 hexadécimal du code d'accès à 6 chiffres.
# Générer : node -e "console.log(require('crypto').createHash('sha256').update('123456').digest('hex'))"
VITE_ACCESS_CODE_HASH=
